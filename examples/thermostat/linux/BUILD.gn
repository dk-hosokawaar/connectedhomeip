import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("${chip_root}/build/config/linux/pkg_config.gni")

executable("thermostat-app") {
  sources = [
    "${chip_root}/examples/thermostat/thermostat-common/src/thermostat-delegate-impl.cpp",
    "include/low-power/LowPowerManager.cpp",
    "include/low-power/LowPowerManager.h",
    "main.cpp",
    "${chip_root}/examples/thermostat/thermostat-common/src/binding-handler.cpp",
    "${chip_root}/examples/thermostat/thermostat-common/src/cluster-plugins/cluster_registry.cpp",
    "${chip_root}/examples/thermostat/thermostat-common/src/cluster-plugins/onoff_handler.cpp",
    "aircon_bridge/external_temp_provider.cpp",
    "${chip_root}/examples/thermostat/thermostat-common/src/cluster-plugins/thermostat_handler.cpp",
    "${chip_root}/examples/thermostat/thermostat-common/src/app-zcl-handler.cpp",
    "demo_shell.cpp",
  ]

  deps = [
    "${chip_root}/examples/platform/linux:app-main",
    "${chip_root}/examples/thermostat/thermostat-common",
    "${chip_root}/src/lib",
  ]


  include_dirs = [
    "include",
    "${chip_root}/examples/thermostat/thermostat-common/include",
    "third_party/connectedhomeip/src/app/clusters/thermostat-server",
    "${chip_root}/examples/thermostat/thermostat-common/include/cluster-plugins",
    "${chip_root}/examples/thermostat/linux/aircon_bridge",
  ]

  defines = [ "ENABLE_CHIP_SHELL" ]

  cflags = [ "-Wconversion" ]
  libs = [ "curl" ]  # ← ここを追加
  output_dir = root_out_dir
}

group("linux") {
  deps = [ ":thermostat-app" ]
}

group("default") {
  deps = [ ":linux" ]
}
